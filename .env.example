# 本地开发（使用 scripts/dev-db.mjs 启动嵌入式 PostgreSQL）
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/d_demo

# Docker Compose 部署。密码中如含特殊字符，请先做 URL 编码。
DATABASE_URL=postgres://study_app:replace-with-strong-password@db:5432/study_data
POSTGRES_USER=study_app
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=study_data
APP_PORT=3000

# 一次性生成，建议使用 openssl rand -hex 32
APP_SECRET=

# 管理员账号。迁移时会写入 admin_users 表；不要使用公开默认密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 公开研究入口的阶段：dev / pilot / formal
COLLECTION_PHASE=formal

# 生产环境必须保持 false/不设置，固定组预览仅管理员和开发模式可用
ALLOW_GROUP_PREVIEW=false

# 部署时填写的公开站点地址
PUBLIC_SITE_URL=https://your-domain.example.com
